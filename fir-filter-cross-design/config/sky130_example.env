# Sky130 HD technology configuration.
# Existing environment variables take priority over these defaults.

export LIBERTY="${LIBERTY:-./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_5v00.lib}"
export TECH_LEF="${TECH_LEF:-./conda-env/share/pdk/sky130A/libs.tech/lef/sky130_fd_sc_hd.tlef}"
export CELL_LEF="${CELL_LEF:-./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lef/sky130_fd_sc_hd.lef}"
# Floorplan mode: utilization or fixed
export FLOORPLAN_MODE="${FLOORPLAN_MODE:-utilization}"

# Fixed die dimensions (microns)
export DIE_WIDTH="${DIE_WIDTH:-250.00}"
export DIE_HEIGHT="${DIE_HEIGHT:-250.00}"

# Fixed core boundaries (microns)
export CORE_LL_X="${CORE_LL_X:-5.0}"
export CORE_LL_Y="${CORE_LL_Y:-5.0}"
export CORE_UR_X="${CORE_UR_X:-245.00}"
export CORE_UR_Y="${CORE_UR_Y:-245.00}"

export UTIL="${UTIL:-40}"
export CLK_PERIOD="${CLK_PERIOD:-10.0}"
export PLACE_DENSITY="${PLACE_DENSITY:-0.40}"
export ENABLE_REPAIR_TIMING="${ENABLE_REPAIR_TIMING:-1}"

export RUN_TAG="${RUN_TAG:-fir_8tap_w8_util40_clk10}"
export RUN_DIR="${RUN_DIR:-fir_project/runs/${RUN_TAG}}"
